{
  "name": "pod-surfer",
  "version": "0.0.0",
  "description": "A podcast listening app",
  "module": "./src/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.js && npm run build-sw",
    "build-sw": "npx workbox-cli injectManifest ./workbox-config.cjs",
    "test": "wtr --config @web/test-runner.config.mjs",
    "test:watch": "wtr --watch --config @web/test-runner.config.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "esbuild": "^0.24.2",
    "idb-keyval": "^6.3.0",
    "lit": "^3.3.3",
    "workbox-background-sync": "^5.1.4",
    "workbox-cacheable-response": "^5.1.4",
    "workbox-cli": "^7.1.0",
    "workbox-expiration": "^5.1.4",
    "workbox-precaching": "^5.1.4",
    "workbox-range-requests": "^5.1.4",
    "workbox-routing": "^5.1.4",
    "workbox-strategies": "^5.1.4"
  },
  "devDependencies": {
    "@web/test-runner": "^0.16.0",
    "@web/test-runner-playwright": "^0.10.0",
    "msw": "^2.0.0",
    "@playwright/test": "^1.45.0",
    "@esm-bundle/chai": "^4.3.4",
    "@web/test-runner-commands": "^0.8.0",
    "typescript": "^7.0.2"
  }
}
